# PostgreSQL connection settings. Set DATABASE_URL or the PG* variables below.
# DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/DATABASE?sslmode=disable
PGHOST=localhost
PGPORT=5432
PGDATABASE=hirepilot
PGUSER=hirepilot
PGPASSWORD=change-me
PGSSLMODE=disable

HTTP_ADDR=:8080
# Generate a unique random value of at least 32 characters for each deployment.
AUTH_SECRET=replace-with-a-random-secret-of-at-least-32-characters
# Set true when serving over HTTPS.
COOKIE_SECURE=false

# AI provider selection. The default is local Ollama; configure its model before
# constructing a provider. Hosted providers require their own API key and model.
AI_DEFAULT_PROVIDER=ollama
AI_OLLAMA_ENABLED=true
AI_OLLAMA_BASE_URL=http://localhost:11434
AI_OLLAMA_MODEL=
AI_OPENAI_ENABLED=false
AI_OPENAI_BASE_URL=https://api.openai.com/v1
AI_OPENAI_API_KEY=
AI_OPENAI_MODEL=
AI_GEMINI_ENABLED=false
AI_GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
AI_GEMINI_API_KEY=
AI_GEMINI_MODEL=
AI_ANTHROPIC_ENABLED=false
AI_ANTHROPIC_BASE_URL=https://api.anthropic.com/v1
AI_ANTHROPIC_API_KEY=
AI_ANTHROPIC_MODEL=
AI_FALLBACK_ENABLED=false
AI_FALLBACK_PROVIDER=
AI_TEMPERATURE=0.2
AI_MAX_OUTPUT_TOKENS=2048
AI_REQUEST_TIMEOUT=90s
AI_MAX_RETRIES=3
AI_RETRY_INITIAL_DELAY=1s
AI_RETRY_MAX_DELAY=10s
MATCHING_ENABLED=true
MATCHING_MIN_SCORE=0
MATCHING_BATCH_SIZE=10
MATCHING_MAX_CONCURRENCY=3
MATCHING_ASYNC=true
